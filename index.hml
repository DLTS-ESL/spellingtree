/* =========================================================
   GAME VARIABLES
========================================================= */

let currentWord = "";

let currentDefinition = "";

let studentWord = "";

let score = 0;

let question = 1;

let answered = false;


/* =========================================================
   HISTORY
========================================================= */

let questionHistory = [];

let historyIndex = -1;


/* =========================================================
   TIMER
========================================================= */

let timeLeft = 300;

let timerInterval;


/* =========================================================
   PLANT GROWTH
========================================================= */

let plantGrowth = 0;


/*
    The plant has 20 growth points.

    Every correct answer = +1 growth.

    Maximum = 20.
*/


/* =========================================================
   SHUFFLE
========================================================= */

function shuffle(array) {

    const newArray = [...array];

    for (
        let i = newArray.length - 1;
        i > 0;
        i--
    ) {

        const j =
            Math.floor(
                Math.random() * (i + 1)
            );

        [
            newArray[i],
            newArray[j]
        ] =
        [
            newArray[j],
            newArray[i]
        ];

    }

    return newArray;
}


/* =========================================================
   GET RANDOM WORD
========================================================= */

function getRandomWord() {

    const allWords =
        [...cvcWords, ...blendWords];

    let word;

    do {

        word =
            allWords[
                Math.floor(
                    Math.random() *
                    allWords.length
                )
            ];

    } while (
        word === currentWord &&
        allWords.length > 1
    );

    return word;

}


/* =========================================================
   NEW QUESTION
========================================================= */

function newQuestion() {

    currentWord =
        getRandomWord();

    currentDefinition =
        definitions[currentWord] ||
        "A word you are learning.";

    studentWord = "";

    answered = false;

    loadWord();

}


/* =========================================================
   LOAD WORD
========================================================= */

function loadWord() {

    document.getElementById(
        "definition"
    ).textContent =
        currentDefinition;


    document.getElementById(
        "correctWord"
    ).textContent = "";


    document.getElementById(
        "message"
    ).textContent = "";


    document.getElementById(
        "message"
    ).className =
        "message";


    document.getElementById(
        "plantHead"
    ).classList.remove(
        "happy"
    );


    createSpellingSlots();

    createLetterButtons();

    updateNavigation();

    updateProgress();

}


/* =========================================================
   SPELLING SLOTS
========================================================= */

function createSpellingSlots() {

    const slots =
        document.getElementById(
            "slots"
        );

    slots.innerHTML = "";


    for (
        let i = 0;
        i < currentWord.length;
        i++
    ) {

        const slot =
            document.createElement(
                "div"
            );

        slot.className =
            "letter-slot";

        slot.textContent =
            studentWord[i] || "";

        slots.appendChild(slot);

    }

}


/* =========================================================
   LETTER BUTTONS
========================================================= */

function createLetterButtons() {

    const row1 =
        document.getElementById(
            "letterRow1"
        );

    const row2 =
        document.getElementById(
            "letterRow2"
        );


    row1.innerHTML = "";

    row2.innerHTML = "";


    let letters =
        currentWord.split("");


    const alphabet =
        "abcdefghijklmnopqrstuvwxyz";


    /*
        Make exactly 10 choices.
    */

    while (letters.length < 10) {

        letters.push(
            alphabet[
                Math.floor(
                    Math.random() *
                    alphabet.length
                )
            ]
        );

    }


    letters =
        shuffle(
            letters.slice(0,10)
        );


    letters.forEach(
        (letter,index) => {

            const button =
                document.createElement(
                    "button"
                );

            button.className =
                "letter-button";

            button.textContent =
                letter.toUpperCase();

            button.onclick =
                () => selectLetter(letter);


            if (index < 5) {

                row1.appendChild(
                    button
                );

            } else {

                row2.appendChild(
                    button
                );

            }

        }
    );

}


/* =========================================================
   SELECT LETTER
========================================================= */

function selectLetter(letter) {

    if (answered) return;

    if (
        studentWord.length >=
        currentWord.length
    ) {
        return;
    }


    studentWord += letter;


    updateSlots();


    saveCurrentQuestion();


    if (
        studentWord.length ===
        currentWord.length
    ) {

        checkAnswer();

    }

}


/* =========================================================
   UPDATE SLOTS
========================================================= */

function updateSlots() {

    const slots =
        document.querySelectorAll(
            ".letter-slot"
        );


    slots.forEach(
        (slot,index) => {

            slot.textContent =
                studentWord[index] || "";

        }
    );

}


/* =========================================================
   CHECK ANSWER
========================================================= */

function checkAnswer() {

    if (
        studentWord ===
        currentWord
    ) {

        correctAnswer();

    } else {

        incorrectAnswer();

    }

}


/* =========================================================
   CORRECT ANSWER
========================================================= */

function correctAnswer() {

    if (answered) return;


    answered = true;


    score++;


    /*
        Grow the plant.

        Maximum = 20.
    */

    plantGrowth =
        Math.min(
            score,
            20
        );


    document.getElementById(
        "score"
    ).textContent =
        score;


    document.getElementById(
        "correctWord"
    ).textContent =
        "The word is: " +
        currentWord.toUpperCase();


    const praiseMessages = [

        "Good Job! ⭐",

        "Well Done! 🎉",

        "Excellent! 🌟",

        "Impressive! 🏆",

        "Great Work! 👏",

        "Awesome! ⭐",

        "Amazing! 🎉",

        "Fantastic! 🌟",

        "You Got It! 🥳",

        "Super Spelling! 🌱"

    ];


    const praise =
        praiseMessages[
            Math.floor(
                Math.random() *
                praiseMessages.length
            )
        ];


    const message =
        document.getElementById(
            "message"
        );


    message.textContent =
        praise;


    message.className =
        "message correct-message";


    document.getElementById(
        "plantHead"
    ).classList.add(
        "happy"
    );


    /*
        Animate plant growth.
    */

    growPlant();


    createStars();


    /*
        Disable letters.
    */

    document
        .querySelectorAll(
            ".letter-button"
        )
        .forEach(
            button => {

                button.disabled = true;

            }
        );


    speakCorrectAnswer();


    saveCurrentQuestion();

}


/* =========================================================
   GROW PLANT
========================================================= */

function growPlant() {

    const plant =
        document.getElementById(
            "plant"
        );


    /*
        Remove all old growth classes.
    */

    for (
        let i = 0;
        i <= 6;
        i++
    ) {

        plant.classList.remove(
            "growth-" + i
        );

    }


    /*
        Convert 20 correct answers
        into 7 visual growth stages.

        0 = pot
        1-3 = seedling
        4-7 = small plant
        8-11 = young plant
        12-15 = small tree
        16-19 = large tree
        20 = full tree
    */

    let stage = 0;


    if (plantGrowth >= 20) {

        stage = 6;

    } else if (plantGrowth >= 16) {

        stage = 5;

    } else if (plantGrowth >= 12) {

        stage = 4;

    } else if (plantGrowth >= 8) {

        stage = 3;

    } else if (plantGrowth >= 4) {

        stage = 2;

    } else if (plantGrowth >= 1) {

        stage = 1;

    }


    plant.classList.add(
        "growth-" + stage
    );


    /*
        Bounce animation.
    */

    plant.classList.remove(
        "grow"
    );


    void plant.offsetWidth;


    plant.classList.add(
        "grow"
    );


    /*
        Update text.
    */

    const growthInfo =
        document.getElementById(
            "growthInfo"
        );


    if (plantGrowth >= 20) {

        growthInfo.textContent =
            "🌳🌸 Fully grown! 20 / 20";

    } else {

        growthInfo.textContent =
            "🌱 " +
            plantGrowth +
            " / 20 correct";

    }

}


/* =========================================================
   INCORRECT ANSWER
========================================================= */

function incorrectAnswer() {

    const message =
        document.getElementById(
            "message"
        );


    message.textContent =
        "Not quite! Try again!";


    message.className =
        "message incorrect-message";


    /*
        Remove the last letter after
        a short delay.
    */

    setTimeout(
        () => {

            if (!answered) {

                studentWord =
                    studentWord.slice(
                        0,
                        -1
                    );

                updateSlots();

                saveCurrentQuestion();

            }

        },
        600
    );

}


/* =========================================================
   DELETE
========================================================= */

function deleteLetter() {

    if (answered) return;


    studentWord =
        studentWord.slice(
            0,
            -1
        );


    updateSlots();

    saveCurrentQuestion();

}


/* =========================================================
   CLEAR
========================================================= */

function clearWord() {

    if (answered) return;


    studentWord = "";

    updateSlots();

    saveCurrentQuestion();

}


/* =========================================================
   NEXT WORD
========================================================= */

function goNext() {

    /*
        If we are looking at an older question,
        remove future questions before making
        the new question.
    */

    if (
        historyIndex <
        questionHistory.length - 1
    ) {

        questionHistory =
            questionHistory.slice(
                0,
                historyIndex + 1
            );

    }


    saveCurrentQuestion();


    newQuestion();


    questionHistory.push({

        word: currentWord,

        definition:
            currentDefinition,

        studentWord: "",

        answered: false

    });


    historyIndex =
        questionHistory.length - 1;


    question =
        historyIndex + 1;


    document.getElementById(
        "questionNumber"
    ).textContent =
        question;


    updateNavigation();

    updateProgress();

}


/* =========================================================
   BACK
========================================================= */

function goBack() {

    /*
        Don't go back beyond Question 1.
    */

    if (
        historyIndex <= 0
    ) {

        return;

    }


    /*
        Save the current question
        before leaving it.
    */

    saveCurrentQuestion();


    /*
        Move backward.
    */

    historyIndex--;


    const previousQuestion =
        questionHistory[
            historyIndex
        ];


    /*
        Restore previous question.
    */

    currentWord =
        previousQuestion.word;


    currentDefinition =
        previousQuestion.definition;


    studentWord =
        previousQuestion.studentWord;


    answered =
        previousQuestion.answered;


    question =
        historyIndex + 1;


    document.getElementById(
        "questionNumber"
    ).textContent =
        question;


    loadWord();


    /*
        If it was already answered,
        show the completed state.
    */

    if (answered) {

        document.getElementById(
            "correctWord"
        ).textContent =
            "The word is: " +
            currentWord.toUpperCase();


        document.getElementById(
            "message"
        ).textContent =
            "You already got this one! ⭐";


        document.getElementById(
            "message"
        ).className =
            "message correct-message";


        document.getElementById(
            "plantHead"
        ).classList.add(
            "happy"
        );


        document
            .querySelectorAll(
                ".letter-button"
            )
            .forEach(
                button => {

                    button.disabled =
                        true;

                }
            );

    }


    updateNavigation();

}


/* =========================================================
   SAVE CURRENT QUESTION
========================================================= */

function saveCurrentQuestion() {

    if (
        historyIndex >= 0 &&
        questionHistory[
            historyIndex
        ]
    ) {

        questionHistory[
            historyIndex
        ].studentWord =
            studentWord;


        questionHistory[
            historyIndex
        ].answered =
            answered;

    }

}


/* =========================================================
   NAVIGATION STATE
========================================================= */

function updateNavigation() {

    const backButton =
        document.getElementById(
            "backButton"
        );


    if (
        historyIndex <= 0
    ) {

        backButton.disabled =
            true;

    } else {

        backButton.disabled =
            false;

    }

}


/* =========================================================
   PROGRESS BAR
========================================================= */

function updateProgress() {

    const progress =
        Math.min(
            (score / 20) * 100,
            100
        );


    document.getElementById(
        "progressBar"
    ).style.width =
        progress + "%";

}


/* =========================================================
   SPEECH
========================================================= */

function speakWord() {

    /*
        Stop previous speech.
    */

    window.speechSynthesis.cancel();


    const speech =
        new SpeechSynthesisUtterance(
            currentWord
        );


    speech.lang =
        "en-US";

    speech.volume =
        1;

    speech.rate =
        0.65;

    speech.pitch =
        1;


    const voices =
        window.speechSynthesis
            .getVoices();


    const englishVoice =
        voices.find(
            voice =>
                voice.lang ===
                "en-US"
        ) ||

        voices.find(
            voice =>
                voice.lang ===
                "en-GB"
        ) ||

        voices.find(
            voice =>
                voice.lang.startsWith(
                    "en"
                )
        );


    if (englishVoice) {

        speech.voice =
            englishVoice;

    }


    window.speechSynthesis.speak(
        speech
    );

}


/* =========================================================
   SPEAK CORRECT ANSWER
========================================================= */

function speakCorrectAnswer() {

    window.speechSynthesis.cancel();


    const speech =
        new SpeechSynthesisUtterance(
            currentWord
        );


    speech.lang =
        "en-US";

    speech.volume =
        1;

    speech.rate =
        0.60;

    speech.pitch =
        1;


    const voices =
        window.speechSynthesis
            .getVoices();


    const englishVoice =
        voices.find(
            voice =>
                voice.lang ===
                "en-US"
        ) ||

        voices.find(
            voice =>
                voice.lang ===
                "en-GB"
        ) ||

        voices.find(
            voice =>
                voice.lang.startsWith(
                    "en"
                )
        );


    if (englishVoice) {

        speech.voice =
            englishVoice;

    }


    window.speechSynthesis.speak(
        speech
    );

}


/* =========================================================
   BLINKING
========================================================= */

function blinkPlant() {

    const plantHead =
        document.getElementById(
            "plantHead"
        );


    /*
        Don't interrupt the happy
        animation immediately.
    */

    if (
        plantHead.classList.contains(
            "happy"
        )
    ) {

        return;

    }


    plantHead.classList.add(
        "blink"
    );


    setTimeout(
        () => {

            plantHead.classList.remove(
                "blink"
            );

        },
        140
    );

}


/*
    Blink every few seconds.

    The timing is randomized so
    it feels more natural.
*/

function scheduleBlink() {

    const delay =
        2500 +
        Math.random() * 3500;


    setTimeout(
        () => {

            blinkPlant();

            scheduleBlink();

        },
        delay
    );

}


scheduleBlink();


/* =========================================================
   STARS
========================================================= */

function createStars() {

    const stars =
        document.getElementById(
            "stars"
        );


    stars.innerHTML = "";


    for (
        let i = 0;
        i < 18;
        i++
    ) {

        const star =
            document.createElement(
                "div"
            );


        star.className =
            "star";


        star.textContent =
            "⭐";


        star.style.left =
            "50%";


        star.style.top =
            "45%";


        star.style.setProperty(
            "--x",
            (
                (Math.random() - 0.5) *
                600
            ) + "px"
        );


        star.style.setProperty(
            "--y",
            (
                (Math.random() - 0.5) *
                400
            ) + "px"
        );


        stars.appendChild(
            star
        );

    }


    setTimeout(
        () => {

            stars.innerHTML = "";

        },
        1300
    );

}


/* =========================================================
   TIMER
========================================================= */

function startTimer() {

    clearInterval(
        timerInterval
    );


    timerInterval =
        setInterval(
            () => {

                timeLeft--;

                updateTimer();


                if (
                    timeLeft <= 0
                ) {

                    clearInterval(
                        timerInterval
                    );

                    endSession();

                }

            },
            1000
        );

}


/* =========================================================
   UPDATE TIMER
========================================================= */

function updateTimer() {

    const minutes =
        Math.floor(
            timeLeft / 60
        );


    const seconds =
        timeLeft % 60;


    const timer =
        document.getElementById(
            "timer"
        );


    timer.textContent =
        minutes +
        ":" +
        String(seconds)
            .padStart(
                2,
                "0"
            );


    timer.classList.remove(
        "warning",
        "danger"
    );


    if (
        timeLeft <= 30
    ) {

        timer.classList.add(
            "danger"
        );

    } else if (
        timeLeft <= 120
    ) {

        timer.classList.add(
            "warning"
        );

    }

}


/* =========================================================
   END SESSION
========================================================= */

function endSession() {

    window.speechSynthesis.cancel();


    document.getElementById(
        "finalScore"
    ).textContent =
        score;


    document.getElementById(
        "sessionOver"
    ).style.display =
        "flex";

}


/* =========================================================
   RESTART SESSION
========================================================= */

function restartSession() {

    document.getElementById(
        "sessionOver"
    ).style.display =
        "none";


    /*
        Reset score.
    */

    score = 0;


    question = 1;


    timeLeft = 300;


    currentWord = "";


    studentWord = "";


    answered = false;


    questionHistory = [];


    historyIndex = -1;


    plantGrowth = 0;


    /*
        Reset plant.
    */

    const plant =
        document.getElementById(
            "plant"
        );


    for (
        let i = 0;
        i <= 6;
        i++
    ) {

        plant.classList.remove(
            "growth-" + i
        );

    }


    plant.classList.add(
        "growth-0"
    );


    document.getElementById(
        "growthInfo"
    ).textContent =
        "🌱 0 / 20 correct";


    document.getElementById(
        "score"
    ).textContent =
        "0";


    /*
        New first question.
    */

    newQuestion();


    questionHistory.push({

        word: currentWord,

        definition:
            currentDefinition,

        studentWord: "",

        answered: false

    });


    historyIndex = 0;


    question = 1;


    document.getElementById(
        "questionNumber"
    ).textContent =
        "1";


    updateNavigation();

    updateProgress();

    updateTimer();

    startTimer();

}


/* =========================================================
   INITIAL GAME
========================================================= */

newQuestion();


questionHistory.push({

    word: currentWord,

    definition:
        currentDefinition,

    studentWord: "",

    answered: false

});


historyIndex = 0;


question = 1;


document.getElementById(
    "questionNumber"
).textContent =
    "1";


updateNavigation();

updateProgress();

updateTimer();

startTimer();


/* =========================================================
   INITIAL PLANT
========================================================= */

growPlant();


</script>

</body>
</html>
