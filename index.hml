<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>English Spelling Garden</title>

<style>

/* =========================================================
   GENERAL
========================================================= */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: "Arial Rounded MT Bold", Arial, sans-serif;
    background: linear-gradient(135deg, #e8f5e9, #fff8e1);
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 12px;
}

.game {
    width: 100%;
    max-width: 780px;

    background: white;

    border-radius: 30px;

    padding: 24px;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.15);

    text-align: center;

    position: relative;

    overflow: hidden;
}


/* =========================================================
   HEADER
========================================================= */

.header {
    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 10px;

    margin-bottom: 12px;
}

.title {
    font-size: 27px;
    font-weight: bold;
    color: #333;
}

.score-box,
.timer-box {
    padding: 9px 15px;

    border-radius: 15px;

    font-size: 17px;

    font-weight: bold;

    white-space: nowrap;
}

.score-box {
    background: #fff3cd;
    color: #856404;
}

.timer-box {
    background: #e8f5e9;
    color: #2e7d32;
}

.timer {
    font-size: 20px;
}

.timer.warning {
    color: #f57c00;
}

.timer.danger {
    color: #d32f2f;

    animation: pulse 1s infinite;
}

@keyframes pulse {

    50% {
        transform: scale(1.08);
    }

}


/* =========================================================
   PROGRESS BAR
========================================================= */

.progress-container {
    width: 100%;

    height: 13px;

    background: #eeeeee;

    border-radius: 20px;

    overflow: hidden;

    margin-bottom: 15px;
}

.progress-bar {
    height: 100%;

    width: 0%;

    background: #81c784;

    border-radius: 20px;

    transition: width 0.5s ease;
}


/* =========================================================
   GARDEN AREA
========================================================= */

.garden-area {

    position: relative;

    height: 245px;

    margin: 5px auto 5px;

    max-width: 500px;

    display: flex;

    justify-content: center;

    align-items: flex-end;

    overflow: hidden;

    border-radius: 25px;

    background:
        linear-gradient(
            to bottom,
            #dff5ff 0%,
            #effff1 65%,
            #c8e6c9 65%,
            #a5d6a7 100%
        );
}


/* little clouds */

.cloud {
    position: absolute;

    font-size: 32px;

    opacity: 0.8;
}

.cloud.one {
    top: 20px;
    left: 12%;
}

.cloud.two {
    top: 55px;
    right: 12%;
}


/* =========================================================
   PLANT
========================================================= */

.plant-container {

    position: relative;

    width: 220px;

    height: 225px;

    display: flex;

    justify-content: flex-end;

    align-items: center;

    flex-direction: column;

    transition: all 0.6s ease;
}


/* TREE TRUNK */

.trunk {

    position: absolute;

    bottom: 43px;

    left: 50%;

    transform: translateX(-50%);

    width: 25px;

    height: 65px;

    background: #9b6b43;

    border-radius: 12px;

    transition:
        height 0.7s ease,
        width 0.7s ease;
}


/* BRANCHES */

.branch {
    position: absolute;

    background: #9b6b43;

    border-radius: 10px;

    opacity: 0;

    transition:
        opacity 0.6s ease,
        transform 0.6s ease;
}

.branch.left {
    width: 55px;
    height: 12px;

    bottom: 85px;
    left: 65px;

    transform: rotate(-35deg);
}

.branch.right {
    width: 55px;
    height: 12px;

    bottom: 95px;
    right: 65px;

    transform: rotate(35deg);
}


/* =========================================================
   LEAVES
========================================================= */

.leaf {
    position: absolute;

    width: 55px;
    height: 42px;

    background: #66bb6a;

    border-radius:
        100% 0 100% 0;

    opacity: 0;

    transform: scale(0);

    transition:
        opacity 0.6s ease,
        transform 0.7s ease;
}

.leaf.l1 {
    bottom: 110px;
    left: 42px;
}

.leaf.l2 {
    bottom: 135px;
    left: 78px;
}

.leaf.l3 {
    bottom: 110px;
    right: 42px;
}

.leaf.l4 {
    bottom: 155px;
    right: 70px;
}

.leaf.l5 {
    bottom: 155px;
    left: 65px;
}

.leaf.l6 {
    bottom: 180px;
    left: 82px;
}


/* =========================================================
   PLANT HEAD
========================================================= */

.plant-head {

    position: relative;

    width: 100px;
    height: 90px;

    background: #81c784;

    border-radius:
        48% 48% 45% 45%;

    border: 4px solid #4caf50;

    display: flex;

    justify-content: center;

    align-items: center;

    z-index: 5;

    transition:
        width 0.7s ease,
        height 0.7s ease,
        background 0.7s ease,
        transform 0.7s ease;
}


/* =========================================================
   PLANT FACE
========================================================= */

.face {

    position: relative;

    width: 65px;
    height: 55px;
}


/* EYES */

.eye {

    position: absolute;

    width: 12px;
    height: 16px;

    background: #333;

    border-radius: 50%;

    top: 10px;

    transition:
        height 0.12s ease;
}

.eye.left {
    left: 9px;
}

.eye.right {
    right: 9px;
}


/* BLINK */

.plant-head.blink .eye {

    height: 2px;

    border-radius: 10px;

}


/* MOUTH */

.mouth {

    position: absolute;

    left: 50%;

    bottom: 6px;

    transform: translateX(-50%);

    width: 28px;
    height: 15px;

    border-bottom:
        4px solid #333;

    border-radius:
        0 0 25px 25px;

    transition:
        width 0.3s ease,
        height 0.3s ease;
}


/* HAPPY MOUTH */

.plant-head.happy .mouth {

    width: 35px;
    height: 20px;

    border-bottom-width: 5px;
}


/* CHEEKS */

.cheek {

    position: absolute;

    width: 13px;
    height: 8px;

    background: #ef9a9a;

    border-radius: 50%;

    opacity: 0.8;

    top: 35px;
}

.cheek.left {
    left: -2px;
}

.cheek.right {
    right: -2px;
}


/* =========================================================
   POT
========================================================= */

.pot {

    position: absolute;

    bottom: 10px;

    width: 100px;
    height: 65px;

    background: #e89b65;

    border-radius:
        5px 5px 30px 30px;

    border-top:
        12px solid #d98252;

    z-index: 4;

    transition:
        transform 0.7s ease;
}

.pot::after {

    content: "";

    position: absolute;

    width: 55px;
    height: 15px;

    background: #6d4c41;

    border-radius: 50%;

    top: -20px;

    left: 50%;

    transform: translateX(-50%);
}


/* =========================================================
   GROWTH LEVELS
========================================================= */

/* LEVEL 0 */

.growth-0 .plant-head {

    width: 55px;
    height: 50px;

    background: #aed581;

    transform:
        translateY(40px);
}

.growth-0 .trunk {
    height: 15px;
}


/* LEVEL 1 */

.growth-1 .plant-head {

    width: 65px;
    height: 58px;

    transform:
        translateY(25px);
}

.growth-1 .trunk {
    height: 25px;
}


/* LEVEL 2 */

.growth-2 .plant-head {

    width: 75px;
    height: 68px;

    transform:
        translateY(15px);
}

.growth-2 .trunk {
    height: 35px;
}

.growth-2 .leaf.l1,
.growth-2 .leaf.l3 {

    opacity: 1;

    transform:
        scale(0.6)
        rotate(-10deg);
}


/* LEVEL 3 */

.growth-3 .plant-head {

    width: 85px;
    height: 75px;

    transform:
        translateY(5px);
}

.growth-3 .trunk {
    height: 45px;
}

.growth-3 .leaf.l1,
.growth-3 .leaf.l2,
.growth-3 .leaf.l3 {

    opacity: 1;

    transform:
        scale(0.8);
}


/* LEVEL 4 */

.growth-4 .plant-head {

    width: 95px;
    height: 85px;

    transform:
        translateY(-8px);
}

.growth-4 .trunk {
    height: 55px;
}

.growth-4 .leaf.l1,
.growth-4 .leaf.l2,
.growth-4 .leaf.l3,
.growth-4 .leaf.l4,
.growth-4 .leaf.l5 {

    opacity: 1;

    transform:
        scale(0.9);
}


/* LEVEL 5 */

.growth-5 .plant-head {

    width: 105px;
    height: 95px;

    transform:
        translateY(-20px);
}

.growth-5 .trunk {

    height: 70px;

    width: 30px;
}

.growth-5 .branch {

    opacity: 1;
}

.growth-5 .leaf {

    opacity: 1;

    transform:
        scale(1);
}


/* LEVEL 6 - FULL TREE */

.growth-6 .plant-head {

    width: 120px;
    height: 105px;

    transform:
        translateY(-32px);
}

.growth-6 .trunk {

    height: 82px;

    width: 32px;
}

.growth-6 .branch {

    opacity: 1;
}

.growth-6 .leaf {

    opacity: 1;

    transform:
        scale(1.15);
}


/* =========================================================
   GROW ANIMATION
========================================================= */

.plant-container.grow {

    animation:
        growBounce 0.8s ease;
}

@keyframes growBounce {

    0% {
        transform: scale(1);
    }

    40% {
        transform: scale(1.12);
    }

    70% {
        transform: scale(0.96);
    }

    100% {
        transform: scale(1);
    }

}


/* =========================================================
   FLOWERS AT FULL GROWTH
========================================================= */

.flower {

    position: absolute;

    font-size: 25px;

    opacity: 0;

    transform: scale(0);

    transition:
        opacity 0.5s ease,
        transform 0.5s ease;
}

.flower.one {
    top: 18px;
    left: 60px;
}

.flower.two {
    top: 45px;
    right: 45px;
}

.flower.three {
    top: 75px;
    left: 30px;
}

.growth-6 .flower {

    opacity: 1;

    transform: scale(1);

}


/* =========================================================
   GROWTH TEXT
========================================================= */

.growth-info {

    position: absolute;

    bottom: 8px;

    left: 50%;

    transform: translateX(-50%);

    background: rgba(255,255,255,0.9);

    padding: 5px 14px;

    border-radius: 20px;

    font-size: 14px;

    font-weight: bold;

    color: #4e6b50;

    z-index: 20;

}


/* =========================================================
   QUESTION
========================================================= */

.step-title {

    font-size: 19px;

    color: #555;

    margin: 7px 0 10px;
}


/* =========================================================
   LISTEN BUTTON
========================================================= */

.listen-button {

    border: none;

    background: #42a5f5;

    color: white;

    padding: 14px 28px;

    border-radius: 18px;

    font-size: 19px;

    font-weight: bold;

    cursor: pointer;

    box-shadow:
        0 5px 10px rgba(0,0,0,0.15);

    transition: 0.2s;

    margin-bottom: 15px;
}

.listen-button:hover {

    transform: scale(1.04);
}

.listen-button:active {

    transform: scale(0.97);
}


/* =========================================================
   SPELLING SLOTS
========================================================= */

.spelling-area {

    margin: 5px 0;
}

.slots {

    display: flex;

    justify-content: center;

    gap: 9px;

    flex-wrap: wrap;

    min-height: 55px;
}

.letter-slot {

    width: 52px;
    height: 52px;

    border-bottom:
        4px solid #555;

    font-size: 30px;

    font-weight: bold;

    color: #333;

    display: flex;

    align-items: center;

    justify-content: center;
}


/* =========================================================
   DEFINITION
========================================================= */

.definition-box {

    margin: 15px auto;

    padding: 13px;

    background: #f3f8ff;

    border-radius: 18px;

    max-width: 600px;
}

.definition-label {

    font-size: 14px;

    font-weight: bold;

    color: #777;

    margin-bottom: 4px;
}

.definition {

    font-size: 18px;

    color: #333;

    line-height: 1.4;
}

.correct-word {

    font-size: 21px;

    color: #43a047;

    font-weight: bold;

    margin-top: 7px;
}


/* =========================================================
   LETTER BUTTONS
========================================================= */

.letter-grid {

    margin: 15px auto;

    max-width: 550px;
}

.letter-row {

    display: flex;

    justify-content: center;

    gap: 8px;

    margin-bottom: 8px;
}

.letter-button {

    width: 62px;
    height: 55px;

    border: none;

    border-radius: 15px;

    background: #ffe082;

    color: #333;

    font-size: 24px;

    font-weight: bold;

    cursor: pointer;

    box-shadow:
        0 4px 7px rgba(0,0,0,0.12);

    transition: 0.15s;
}

.letter-button:hover {

    transform: translateY(-2px);

    background: #ffd54f;
}

.letter-button:active {

    transform: scale(0.94);
}

.letter-button:disabled {

    opacity: 0.5;

    cursor: not-allowed;

}


/* =========================================================
   CONTROLS
========================================================= */

.controls {

    display: flex;

    justify-content: center;

    gap: 10px;

    flex-wrap: wrap;

    margin-top: 7px;
}

.control-button {

    border: none;

    padding: 11px 20px;

    border-radius: 15px;

    font-size: 16px;

    font-weight: bold;

    cursor: pointer;
}

.delete-button {

    background: #ffab91;

    color: #5d220f;
}

.clear-button {

    background: #ef9a9a;

    color: #5d1010;
}


/* =========================================================
   NAVIGATION
========================================================= */

.navigation {

    display: flex;

    justify-content: center;

    gap: 12px;

    margin-top: 17px;
}

.nav-button {

    border: none;

    padding: 13px 26px;

    border-radius: 18px;

    font-size: 17px;

    font-weight: bold;

    cursor: pointer;

    min-width: 130px;

    transition: 0.2s;
}

.nav-button:hover {

    transform: translateY(-2px);
}

.back-button {

    background: #b0bec5;

    color: #263238;
}

.back-button:disabled {

    opacity: 0.45;

    cursor: not-allowed;

    transform: none;
}

.next-button {

    background: #66bb6a;

    color: white;
}


/* =========================================================
   MESSAGE
========================================================= */

.message {

    min-height: 32px;

    margin-top: 10px;

    font-size: 21px;

    font-weight: bold;
}

.correct-message {

    color: #43a047;
}

.incorrect-message {

    color: #e53935;
}


/* =========================================================
   STARS
========================================================= */

.stars {

    position: absolute;

    inset: 0;

    pointer-events: none;

    overflow: hidden;
}

.star {

    position: absolute;

    font-size: 30px;

    animation:
        starFly 1.2s ease-out forwards;
}

@keyframes starFly {

    0% {

        opacity: 1;

        transform:
            translate(0,0)
            scale(0.5);
    }

    100% {

        opacity: 0;

        transform:
            translate(var(--x),var(--y))
            scale(1.5)
            rotate(180deg);
    }

}


/* =========================================================
   SESSION OVER
========================================================= */

.session-over {

    display: none;

    position: fixed;

    inset: 0;

    background:
        rgba(0,0,0,0.65);

    justify-content: center;

    align-items: center;

    padding: 20px;

    z-index: 100;
}

.session-card {

    background: white;

    padding: 35px;

    border-radius: 25px;

    text-align: center;

    max-width: 450px;

    width: 100%;
}

.session-card h2 {

    font-size: 32px;

    margin-top: 0;
}

.session-card p {

    font-size: 21px;
}

.restart-button {

    border: none;

    background: #42a5f5;

    color: white;

    padding: 15px 30px;

    border-radius: 18px;

    font-size: 20px;

    font-weight: bold;

    cursor: pointer;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    body {
        padding: 7px;
    }

    .game {
        padding: 15px 10px;
        border-radius: 22px;
    }

    .header {
        flex-wrap: wrap;
        justify-content: center;
    }

    .title {
        width: 100%;
        font-size: 23px;
    }

    .score-box,
    .timer-box {
        font-size: 15px;
    }

    .garden-area {
        height: 215px;
    }

    .plant-container {
        transform: scale(0.88);
    }

    .letter-button {
        width: 54px;
        height: 51px;
        font-size: 22px;
    }

    .letter-slot {
        width: 46px;
        height: 48px;
        font-size: 27px;
    }

    .navigation {
        gap: 7px;
    }

    .nav-button {
        min-width: 110px;
        padding: 11px 13px;
        font-size: 16px;
    }

}


/* =========================================================
   EXTRA SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .letter-button {
        width: 48px;
        height: 48px;
    }

    .letter-row {
        gap: 5px;
    }

    .plant-container {
        transform: scale(0.78);
    }

}

</style>
</head>


<body>


<div class="game">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="header">

        <div class="title">
            🌱 English Spelling Garden
        </div>

        <div class="score-box">
            ⭐ <span id="score">0</span>
        </div>

        <div class="timer-box">
            ⏱️ <span id="timer" class="timer">
                5:00
            </span>
        </div>

    </div>


    <!-- =====================================================
         PROGRESS
    ====================================================== -->

    <div class="progress-container">

        <div
            class="progress-bar"
            id="progressBar">
        </div>

    </div>


    <!-- =====================================================
         GARDEN / PLANT
    ====================================================== -->

    <div class="garden-area">

        <div class="cloud one">
            ☁️
        </div>

        <div class="cloud two">
            ☁️
        </div>


        <div
            class="plant-container growth-0"
            id="plant"
        >

            <!-- FLOWERS -->

            <div class="flower one">
                🌸
            </div>

            <div class="flower two">
                🌼
            </div>

            <div class="flower three">
                🌸
            </div>


            <!-- BRANCHES -->

            <div class="branch left"></div>

            <div class="branch right"></div>


            <!-- LEAVES -->

            <div class="leaf l1"></div>

            <div class="leaf l2"></div>

            <div class="leaf l3"></div>

            <div class="leaf l4"></div>

            <div class="leaf l5"></div>

            <div class="leaf l6"></div>


            <!-- TRUNK -->

            <div class="trunk"></div>


            <!-- PLANT FACE -->

            <div
                class="plant-head"
                id="plantHead"
            >

                <div class="face">

                    <div class="eye left"></div>

                    <div class="eye right"></div>

                    <div class="cheek left"></div>

                    <div class="cheek right"></div>

                    <div class="mouth"></div>

                </div>

            </div>


            <!-- POT -->

            <div class="pot"></div>


        </div>


        <div
            class="growth-info"
            id="growthInfo"
        >
            🌱 0 / 20 correct
        </div>

    </div>


    <!-- =====================================================
         QUESTION
    ====================================================== -->

    <div class="step-title">

        Question
        <span id="questionNumber">1</span>

    </div>


    <!-- =====================================================
         LISTEN
    ====================================================== -->

    <button
        class="listen-button"
        onclick="speakWord()"
    >

        🔊 Hear the Word

    </button>


    <!-- =====================================================
         SPELLING AREA
    ====================================================== -->

    <div class="spelling-area">


        <div
            class="slots"
            id="slots"
        ></div>


        <!-- DEFINITION -->

        <div class="definition-box">

            <div class="definition-label">
                💡 What does it mean?
            </div>

            <div
                class="definition"
                id="definition"
            ></div>

            <div
                class="correct-word"
                id="correctWord"
            ></div>

        </div>


    </div>


    <!-- =====================================================
         LETTER BUTTONS
    ====================================================== -->

    <div class="letter-grid">

        <div
            class="letter-row"
            id="letterRow1"
        ></div>

        <div
            class="letter-row"
            id="letterRow2"
        ></div>

    </div>


    <!-- =====================================================
         CONTROLS
    ====================================================== -->

    <div class="controls">

        <button
            class="control-button delete-button"
            onclick="deleteLetter()"
        >
            ⌫ Delete
        </button>

        <button
            class="control-button clear-button"
            onclick="clearWord()"
        >
            ✕ Clear
        </button>

    </div>


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <div class="navigation">

        <button
            id="backButton"
            class="nav-button back-button"
            onclick="goBack()"
        >
            ← Back
        </button>


        <button
            class="nav-button next-button"
            onclick="goNext()"
        >
            Next Word →
        </button>

    </div>


    <!-- =====================================================
         MESSAGE
    ====================================================== -->

    <div
        class="message"
        id="message"
    ></div>


    <!-- STARS -->

    <div
        class="stars"
        id="stars"
    ></div>


</div>



<!-- =========================================================
     SESSION OVER
========================================================= -->

<div
    class="session-over"
    id="sessionOver"
>

    <div class="session-card">

        <h2>
            ⏰ Time's Up!
        </h2>

        <div style="font-size:70px;">
            🌳⭐
        </div>

        <p>
            Great work growing your spelling garden!
        </p>

        <p>
            You spelled
            <strong>
                <span id="finalScore">0</span>
            </strong>
            words correctly.
        </p>

        <p>
            🌱 Keep practicing and keep growing!
        </p>

        <button
            class="restart-button"
            onclick="restartSession()"
        >
            🔄 Start Again
        </button>

    </div>

</div>



<script>


/* =========================================================
   WORD LISTS
========================================================= */

const cvcWords = [

    "cat","bat","hat","mat","rat","sat","fat","pat",
    "cap","map","tap","nap",
    "bag","rag","tag","wag",
